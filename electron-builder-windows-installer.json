{
  "appId": "com.xuan.syncwatch.server",
  "productName": "SyncWatch同步观影",
  "copyright": "Copyright © 2026 xuan",
  "asar": true,
  "compression": "maximum",
  "electronLanguages": ["zh-CN"],
  "removePackageScripts": true,
  "directories": { "output": "dist" },
  "files": [
    "electron-pink.js",
    "electron-main-preload.js",
    "electron-settings-preload.js",
    "server/index.js",
    "server/ai-relay.js",
    "server/macos-distribution.js",
    "server/latest-release.js",
    "server/client-address-privacy.js",
    "public/**/*",
    "package.json",
    "assets/app-icon.ico"
  ],
  "asarUnpack": [
    "node_modules/ffmpeg-static/**/*",
    "node_modules/ffprobe-static/**/*"
  ],
  "extraResources": [
    { "from": "vendor/cloudflared.exe", "to": "vendor/cloudflared.exe" },
    { "from": ".build/offline-bundle/windows", "to": "offline-downloads/windows" },
    { "from": ".build/offline-bundle/android", "to": "offline-downloads/android" },
    { "from": ".build/offline-bundle/mac", "to": "offline-downloads/mac" }
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/app-icon.ico",
    "executableName": "SyncWatch同步观影",
    "requestedExecutionLevel": "asInvoker",
    "signExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SyncWatch同步观影",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "SyncWatch-v2.2.8-Full-Offline-Installer-${arch}.exe"
  }
}

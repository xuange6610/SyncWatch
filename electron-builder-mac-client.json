{
  "appId": "com.xuan.syncwatch.client",
  "productName": "SyncWatch同步观影",
  "copyright": "Copyright © 2026 xuan",
  "asar": true,
  "compression": "maximum",
  "electronLanguages": ["zh-CN"],
  "removePackageScripts": true,
  "artifactName": "SyncWatch-Client-macOS-v2.2.5-${arch}.${ext}",
  "directories": { "output": "dist" },
  "files": [
    "electron-client.js",
    "electron-client-preload.js",
    "client-launcher.html",
    "public/vendor/three/three.min.js",
    "public/vendor/three/GLTFLoader.js",
    "public/vendor/three/LICENSE",
    "assets/app-icon.png",
    "package.json"
  ],
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "icon": "assets/app-icon.png",
    "category": "public.app-category.entertainment",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "SyncWatch同步观影 需要麦克风权限用于房间语音和桌面共享语音。",
      "NSCameraUsageDescription": "SyncWatch同步观影 需要摄像头权限用于实时互动。",
      "NSLocationWhenInUseUsageDescription": "SyncWatch同步观影 仅在您授权后向当前房间显示位置。",
      "NSScreenCaptureUsageDescription": "SyncWatch同步观影 需要屏幕录制权限用于共享桌面画面与声音。"
    }
  },
  "extraMetadata": { "main": "electron-client.js", "name": "syncwatch-client", "version": "2.2.5", "description": "SyncWatch同步观影" }
}

{
  "appId": "com.xuan.syncwatch.server",
  "productName": "SyncWatch同步观影",
  "copyright": "Copyright © 2026 xuan",
  "asar": true,
  "compression": "maximum",
  "electronLanguages": ["zh-CN"],
  "removePackageScripts": true,
  "artifactName": "SyncWatch-Full-Offline-macOS-v2.2.2-${arch}.${ext}",
  "directories": { "output": "dist" },
  "files": [
    "electron-pink.js",
    "electron-main-preload.js",
    "electron-settings-preload.js",
    "server/index.js",
    "server/ai-relay.js",
    "server/macos-distribution.js",
    "public/**/*",
    "package.json",
    "assets/app-icon.png"
  ],
  "asarUnpack": [
    "node_modules/ffmpeg-static/**/*",
    "node_modules/ffprobe-static/**/*"
  ],
  "extraResources": [
    { "from": "vendor/cloudflared-darwin-x64", "to": "vendor/cloudflared-darwin-x64" },
    { "from": "vendor/cloudflared-darwin-arm64", "to": "vendor/cloudflared-darwin-arm64" },
    { "from": ".build/offline-bundle/windows", "to": "offline-downloads/windows" },
    { "from": ".build/offline-bundle/android", "to": "offline-downloads/android" },
    { "from": ".build/offline-bundle/mac", "to": "offline-downloads/mac" }
  ],
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/app-icon.png",
    "category": "public.app-category.entertainment",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "SyncWatch同步观影 需要麦克风权限用于房间语音和桌面共享语音。",
      "NSCameraUsageDescription": "SyncWatch同步观影 需要摄像头权限用于实时互动。",
      "NSLocationWhenInUseUsageDescription": "SyncWatch同步观影 仅在您授权后向当前房间显示位置。",
      "NSScreenCaptureUsageDescription": "SyncWatch同步观影 需要屏幕录制权限用于共享桌面画面与声音。"
    }
  },
  "extraMetadata": { "description": "SyncWatch同步观影" }
}

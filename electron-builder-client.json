{
  "appId": "com.xuan.syncwatch.client",
  "productName": "SyncWatch同步观影",
  "copyright": "Copyright © 2026 xuan",
  "asar": true,
  "compression": "normal",
  "electronLanguages": ["zh-CN"],
  "removePackageScripts": true,
  "directories": { "output": "dist" },
  "files": [
    "electron-client.js",
    "electron-client-preload.js",
    "client-launcher.html",
    "public/vendor/three/three.min.js",
    "public/vendor/three/GLTFLoader.js",
    "public/vendor/three/LICENSE",
    "assets/app-icon.ico",
    "package.json"
  ],
  "extraMetadata": { "main": "electron-client.js", "name": "syncwatch-client", "version": "2.3.9", "description": "SyncWatch同步观影" },
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "assets/app-icon.ico",
    "executableName": "SyncWatch同步观影",
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": { "artifactName": "SyncWatch-Experience-Client-Portable-v2.3.9-${arch}.exe" }
}
